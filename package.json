{
  "name": "opsterm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OpsTerm - Linux-first secure terminal client for network operations",
  "scripts": {
    "dev": "vite",
    "build": "python3 scripts/build_guard.py -- npm run build:frontend",
    "build:frontend": "tsc --noEmit && vite build",
    "build:egui": "python3 scripts/build_guard.py -- cargo build -p opsterm-egui --release --locked",
    "build:native": "python3 scripts/build_guard.py -- cargo build -p opsterm-native --release --locked",
    "test:rust": "python3 scripts/build_guard.py -- cargo test -p opsterm-core -p opsterm-egui --locked -- --test-threads=1",
    "test:build-guard": "python3 -m unittest scripts/test_build_guard.py",
    "clean": "bash scripts/clean.sh",
    "clean:all": "bash scripts/clean.sh --all",
    "update:keygen": "bash scripts/update-keygen.sh",
    "package:egui": "python3 scripts/package_egui.py",
    "package:egui:local": "python3 scripts/package_egui.py --local",
    "install:desktop": "bash scripts/install-desktop.sh",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "python3 scripts/build_guard.py -- tauri build",
    "pages:build": "python3 scripts/build_guard.py -- python3 scripts/build_pages.py",
    "pages:test": "python3 scripts/build_guard.py -- playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.4.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.4.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
